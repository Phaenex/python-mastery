{
  "name": "python-mastery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:lessons": "node scripts/check-lessons.mjs",
    "verify": "npm run check:lessons && npm run test && npm run lint && npx tsc --noEmit && npm run build && npm run check:all",
    "test": "vitest run",
    "check:a11y": "node scripts/a11y-axe.mjs",
    "check:ux": "node scripts/a11y-verify.mjs",
    "check:keyboard": "node scripts/a11y-keyboard.mjs",
    "check:modals": "node scripts/a11y-modals.mjs",
    "check:components": "node scripts/a11y-components.mjs",
    "check:semantics": "node scripts/a11y-semantics.mjs",
    "check:all": "node scripts/a11y-all.mjs"
  },
  "dependencies": {
    "next": "16.2.3",
    "openai": "^4.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
