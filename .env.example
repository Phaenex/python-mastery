# python-mastery env vars

# The in-lesson AI tutor. Optional: without a key the tutor UI renders and every
# send returns 503 with a clear message rather than failing silently.
#
# Preferred. OpenRouter is OpenAI-wire-compatible, so the same SDK is used with a
# different baseURL. Takes precedence when both keys are present.
OPENROUTER_API_KEY=

# Fallback, only used when OPENROUTER_API_KEY is unset.
OPENAI_API_KEY=

# Optional model override. Defaults to openai/gpt-4o-mini on OpenRouter, or
# gpt-4o-mini when using a direct OpenAI key. Small and cheap on purpose: this
# answers "nudge me" questions, and it is called once per user message.
TUTOR_MODEL=
